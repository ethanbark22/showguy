# Copy this file to .env.local and fill in what you need. Never commit .env.local.
# Everything here is optional to LAUNCH the site, except one way to receive forms.

# --- Your public web address (set once you have a domain) ---
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Where form submissions go. Use either, or both. ---
# Option A: a webhook (Google Sheets via Apps Script, Zapier, Make, a CRM…)
FORM_WEBHOOK_URL=
# Option B: email through Resend (resend.com)
RESEND_API_KEY=
FORM_TO_EMAIL=you@example.com
FORM_FROM_EMAIL="SHOWGUY <forms@example.com>"

# --- Analytics (all optional) ---
NEXT_PUBLIC_VERCEL_ANALYTICS=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Local development only: preview the fake case-study layout ---
NEXT_PUBLIC_SHOW_SAMPLE_CASE_STUDIES=false
